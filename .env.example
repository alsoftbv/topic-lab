# Local signing env for `npm run tauri:build`.
# Copy this file to `.env` (gitignored) and fill in the values.
#
# TAURI_SIGNING_PRIVATE_KEY        — the contents of src-tauri/.tauri-signing-key (one line)
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD — the password you set when generating that key

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
