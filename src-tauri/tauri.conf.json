{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MQTT Topic Lab",
    "version": "../package.json",
    "identifier": "com.alsoft.topiclab",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/alsoftbv/topic-lab/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMTAwNTY1Mzc0M0EyNUYKUldSZm9rTTNaUVVRcTZyTHlSWWI0TkJWT1I5TnJjYVR5cDhpMzlaMEt2bmpDVGdZMUtkTitKOXQK"
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png"
        ]
    }
}